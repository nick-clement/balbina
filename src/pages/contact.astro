---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import BookingPreview from '../components/BookingPreview.astro';
import { site } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';
---

<Base
  title="Contact | Child Psychotherapist in Bath | Balbina Garza Delgado"
  description="Get in touch to book a free 15-minute call or an initial consultation for child and adolescent psychotherapy in Bath or online."
  jsonLd={[breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact' }])]}
>
  <PageHead art="sun">
      <h1>Get in touch</h1>
      <p class="lede">
        Pick a time for a free 15-minute call, or phone or email to arrange an initial consultation.
      </p>
    </PageHead>

  <section class="section">
    <div class="container split">
      <div>
        <ul class="facts">
          <li><strong>Phone</strong><a href={`tel:${site.phoneIntl}`}>{site.phone}</a></li>
          <li><strong>Email</strong><a href={`mailto:${site.email}?subject=Web%20Enquiry`}>Email me</a></li>
          <li>
            <strong>Where</strong>
            {site.showAddress ? <a href={site.mapUrl} target="_blank" rel="noopener">{site.address.street}, {site.address.locality} {site.address.postcode}</a> : 'Bath'}
            <span class="fact-sub">A 6 minute walk from Bath train station</span>
          </li>
          <li>
            <strong>Sessions</strong>
            In person across Bath and North East Somerset, or online anywhere in the UK
          </li>
          <li>
            <strong>Hours</strong>
            <dl class="hours">
              {site.hours.map((h) => (<><dt>{h.day}</dt><dd>{h.label}</dd></>))}
              <dt>Friday to Sunday</dt><dd>Closed</dd>
            </dl>
          </li>
        </ul>
        <p class="muted" style="margin-top:1.5rem">
          This is not an emergency service. If a child or young person is in immediate danger, call 999.
        </p>
      </div>

      <BookingPreview />
    </div>
  </section>

</Base>
