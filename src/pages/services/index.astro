---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Cta from '../../components/Cta.astro';
import { breadcrumbSchema } from '../../lib/schema';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Child, Teen & Parent Psychotherapy in Bath | Services"
  description="Psychotherapy for children, adolescents, young adults, parents and babies in Bath, with online sessions across the UK."
  jsonLd={[breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Services', path: '/services' }])]}
>
  <PageHead art="kite">
      <h1>How I can help</h1>
      <p class="lede">
        Psychotherapy for children, teenagers, young adults, parents and babies, in person in Bath and
        online across the UK.
      </p>
    </PageHead>

  <section class="section">
    <div class="container">
      <ul class="index">
        {services.map((s) => (
          <li>
            <a href={`/services/${s.id}`}>
              <span class="index-title">{s.data.title}</span>
              <span class="index-body">
                {s.data.ages && <span class="index-ages">{s.data.ages}</span>}
                <span class="index-text">{s.data.summary}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-tint">
    <div class="container split">
      <h2>Common concerns</h2>
      <p class="prose">
        Anxiety, school worries, low mood, anger and more. <a href="/concerns">See what I help with</a>.
      </p>
    </div>
  </section>

  <Cta />
</Base>
