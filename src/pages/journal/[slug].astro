---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { articleSchema, breadcrumbSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = (await getCollection('journal')).filter((p) => !p.data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const path = `/journal/${entry.id}`;
const fmt = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' });
---

<Base
  title={d.seoTitle ?? `${d.title} | Balbina Garza Delgado`}
  description={d.description}
  ogType="article"
  jsonLd={[
    articleSchema(d.title, d.description, path, d.date),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Journal', path: '/journal' },
      { name: d.title, path },
    ]),
  ]}
>
  <div class="page-head">
    <div class="container">
      <h1>{d.title}</h1>
      <p class="muted">{fmt.format(d.date)}</p>
    </div>
  </div>

  <section class="section">
    <div class="container prose">
      <Content />
    </div>
  </section>

  <Cta />
</Base>
