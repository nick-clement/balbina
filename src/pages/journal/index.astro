---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Illustration from '../../components/Illustration.astro';
import Cta from '../../components/Cta.astro';

const posts = (await getCollection('journal'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' });
---

<Base
  title="Journal | Notes for Parents | Balbina Garza Delgado"
  description="Plain-English articles for parents on children's emotional wellbeing, behaviour and therapy, from a child and adolescent psychotherapist in Bath."
  noindex={posts.length === 0}
>
  <PageHead art="book">
      <h1>Notes for parents</h1>
      <p class="lede">Plain-English writing on children's feelings, behaviour and what helps.</p>
    </PageHead>

  <section class="section">
    <div class="container">
      {posts.length === 0 && <p class="prose">Articles for parents are on their way.</p>}
      <ul class="post-grid">
        {posts.map((p) => (
          <li>
            <a class="post-card" href={`/journal/${p.id}`}>
              <div class="post-card-art">
                <Illustration name={p.data.art} class="post-card-pic" id={`card-${p.id}`} />
              </div>
              <div class="post-card-body">
                <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
                <h2>{p.data.title}</h2>
                <p>{p.data.description}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Cta />
</Base>
