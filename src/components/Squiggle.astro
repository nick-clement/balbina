---
// A single continuous scribble, a nod to the squiggle game used in child psychotherapy.
// With animate, it draws itself once on load (see .squiggle.is-drawn in global.css).
interface Props {
  id: string;
  animate?: boolean;
  class?: string;
}
const { id, animate = false, class: cls = '' } = Astro.props;
---

<svg
  class:list={['squiggle', cls, { 'is-drawn': animate }]}
  viewBox="0 0 800 520"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <filter id={`${id}-wax`} x="-5%" y="-5%" width="110%" height="110%">
      <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="4" result="n" />
      <feDisplacementMap in="SourceGraphic" in2="n" scale="7" />
    </filter>
  </defs>
  <path
    pathLength="1"
    filter={`url(#${id}-wax)`}
    d="M30 440 C 120 340 210 510 300 410 C 380 322 330 190 420 170 C 520 148 560 290 490 330 C 430 364 380 290 440 240 C 500 192 600 150 680 90 C 740 46 790 110 740 170 C 690 230 600 200 610 140 C 618 92 700 120 720 200 C 745 300 700 430 600 470"
  />
</svg>
