---
import { site } from '../data/site';
import Illustration from './Illustration.astro';
interface Props {
  heading?: string;
  text?: string;
}
const {
  heading = 'A good first step is a conversation',
  text = 'Tell me what is worrying you. The call is free, lasts 15 minutes, and you are under no obligation.',
} = Astro.props;
---

<section class="cta">
  <div class="container cta-inner">
    <div>
      <h2>{heading}</h2>
      <p>{text}</p>
      <div class="cta-actions">
        <a class="btn" href="/contact">{site.freeCall}</a>
        <a class="link-quiet" href={`tel:${site.phoneIntl}`}>or call {site.phone}</a>
      </div>
      <p class="cta-es"><a href="/es" lang="es" hreflang="es"><span aria-hidden="true">🇪🇸</span> Sesiones en español. Llama o escribe en español.</a></p>
    </div>
    <Illustration name="crayons" id="cta-crayons" class="cta-art" />
  </div>
</section>
