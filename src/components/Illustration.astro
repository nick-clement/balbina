---
import { illustrations, type IllustrationName } from '../data/illustrations';

interface Props {
  name: IllustrationName;
  class?: string;
  id?: string;
}
const { name, class: cls = '', id = name } = Astro.props;
const items: { d: string; f?: boolean; t?: string; dot?: boolean }[] = illustrations[name];
const fid = `ill-${id}-wax`;
---

<svg
  class:list={['illustration', cls]}
  viewBox="0 0 480 400"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <filter id={fid} x="-5%" y="-5%" width="110%" height="110%">
      <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="7" result="n" />
      <feDisplacementMap in="SourceGraphic" in2="n" scale="6" />
    </filter>
  </defs>
  <g filter={`url(#${fid})`}>
    {items.map((i, n) => (
      <path
        d={i.d}
        transform={i.t}
        pathLength={i.dot ? undefined : 1}
        style={`--i:${n}`}
        class:list={{ f: i.f, dot: i.dot }}
      />
    ))}
  </g>
</svg>

<script>
  // Draw each picture in once, when it scrolls into view.
  const pics = document.querySelectorAll<SVGElement>('.illustration');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-drawn');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.35 }
    );
    pics.forEach((p) => io.observe(p));
  } else {
    pics.forEach((p) => p.classList.add('is-drawn'));
  }
</script>
